; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.1"

[application]

config/name="Cycling through Finland - Pedal Project"
run/main_scene="uid://dg1halhkihrb6"
config/features=PackedStringArray("4.6", "GL Compatibility")

[audio]

buses/default_bus_layout="uid://27c47l767ugy"

[autoload]

HighScores="*uid://qfh87rfpe5hu"
GlobalWahoo="*uid://bg14qjom7nrj0"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1200
window/size/mode=4
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/rmsmartshape/plugin.cfg")

[global_group]

player=""
ui=""
terrain=""

[layer_names]

2d_physics/layer_1="Ground"
2d_physics/layer_2="Player"
2d_physics/layer_3="Items"
2d_physics/layer_4="Sensors"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.446069, 0.68983257, 0.8893257, 1)
